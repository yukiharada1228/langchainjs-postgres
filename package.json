{
  "name": "@yukiharada1228/langchain-postgres",
  "version": "0.1.2",
  "description": "Unofficial LangChain.js port of langchain-postgres (Postgres/pgvector integrations for LangChain).",
  "keywords": [
    "langchain",
    "langchainjs",
    "postgres",
    "postgresql",
    "pgvector",
    "vectorstore",
    "embeddings"
  ],
  "homepage": "https://github.com/yukiharada1228/langchainjs-postgres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiharada1228/langchainjs-postgres.git"
  },
  "license": "MIT",
  "author": "yukiharada1228",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:package": "npm run build && tsx scripts/test-package.ts",
    "check:upstream": "tsx scripts/check-upstream.ts",
    "diff:upstream": "tsx scripts/diff-upstream.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0 <2.0.0",
    "langsmith": ">=0.1.43 <0.10.10 || >=0.10.12 <1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.7.0"
}
